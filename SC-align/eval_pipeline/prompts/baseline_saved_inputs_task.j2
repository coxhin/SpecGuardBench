Example loader and replay structure:

```python
import json
import os

from package.module import function_under_test


def _load_cases():
    with open(os.environ["AGENT_SAVED_INPUTS_PATH"], "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                yield json.loads(line)


def test_saved_inputs_satisfy_spec():
    for case in _load_cases():
        result = function_under_test(*case.get("args", []), **case.get("kwargs", {}))
        # Replace this placeholder with concrete assertions from the spec.
        assert property_required_by_spec(result)
```

Example filesystem reconstruction:

```python
def test_saved_file_inputs(tmp_path):
    for case in _load_cases():
        for file_record in case.get("tmp_files", []):
            path = tmp_path / file_record["name"]
            path.write_text(file_record["content"], encoding="utf-8")

        args = [str(tmp_path / name) for name in case.get("args", [])]
        result = function_under_test(*args, **case.get("kwargs", {}))
        # Replace this placeholder with concrete assertions from the spec.
        assert file_property_required_by_spec(result)
```

